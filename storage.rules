rules_version = '2';

// ── Ophthalmology Platform — Cloud Storage Security Rules (Sprint 16) ────────
//
// CURRENT MODE: Authenticated, claim-isolated, path-scoped, default-deny.
//
//   • Only the structured, CLINIC-SCOPED document tree is reachable:
//       documents/{clinicId}/{linkedEntityType}/{linkedEntityId}/{documentId}/{fileName}
//   • The clinic check uses the {clinicId} segment of the OBJECT PATH against
//     the session's custom claim — never file metadata or client-submitted
//     fields, so a tampered request body cannot cross clinics.
//   • Staff sessions (claims minted by backend/claims-admin.js) can only
//     touch files under their own clinic; a 'network' claim grants
//     cross-clinic executive access.
//   • Claimless anonymous sandbox sessions retain demo access (documented;
//     the sandbox holds no real PHI).
//   • Uploads: max 25 MB, PDF / image / Word content types only.
//   • No public or unauthenticated access; no listing; objects resolve only
//     via per-object token-scoped getDownloadURL().
//   • Everything outside /documents/** is denied by default.
//
// DEPLOY GATE (owner): the default bucket requires the Blaze plan
// (billingEnabled is currently false). Owner steps:
//   1. Firebase Console → upgrade to Blaze (free tier still applies)
//   2. Build → Storage → Get Started
//   3. firebase deploy --only storage --project ophthalmology-abd50
//   4. node security-tests/test-rules-storage-documents.js  (must pass)
//
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    /** Clinic claim on the session token, or null for sandbox/anonymous. */
    function claimClinic() {
      return ('clinicId' in request.auth.token) ? request.auth.token.clinicId : null;
    }

    /** Path-derived clinic isolation — the claim must match the path segment. */
    function clinicAllowed(pathClinic) {
      return claimClinic() == null            // sandbox (no claim, demo data)
        || claimClinic() == 'network'         // executive scope
        || claimClinic() == pathClinic;       // file belongs to the claimed clinic
    }

    function isAllowedFileType() {
      return request.resource.contentType == 'application/pdf'
        || request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    }

    match /documents/{clinicId}/{entityType}/{entityId}/{documentId}/{fileName} {
      allow read: if isSignedIn() && clinicAllowed(clinicId);
      allow write: if isSignedIn() && clinicAllowed(clinicId)
        && request.resource.size < 25 * 1024 * 1024
        && isAllowedFileType();
      allow delete: if isSignedIn() && clinicAllowed(clinicId);
    }

    // Everything else: no match → denied.
  }
}
