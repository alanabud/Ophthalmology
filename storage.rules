rules_version = '2';

// ── Ophthalmology Platform — Cloud Storage Security Rules (Sprint 13) ────────
//
// CURRENT MODE: Authenticated, path-scoped, default-deny.
//
//   • Only the structured document tree is reachable:
//       documents/{linkedEntityType}/{linkedEntityId}/{documentId}/{fileName}
//   • Every read/write requires a Firebase Auth session (the app signs in
//     anonymously at startup) — no public or anonymous file access.
//   • Uploads are capped at 25 MB and must declare an allowed content type
//     (PDF, image, or Word document).
//   • Listing is never granted; objects resolve only via per-object
//     token-scoped getDownloadURL() calls. Firestore stores storagePath only.
//   • Everything outside /documents/** is denied by default.
//
// NOTE: This file deploys with `firebase deploy --only storage` once the
// project owner provisions the default bucket (Console → Build → Storage →
// Get Started). Until then it is version-controlled and ready.
//
// KNOWN LIMIT (requires a backend before a real-PHI pilot):
//   Per-user role / clinic enforcement needs custom claims from a trusted
//   server. Tracked on /admin/pilot-readiness.
//
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAllowedFileType() {
      return request.resource.contentType == 'application/pdf'
        || request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
    }

    match /documents/{entityType}/{entityId}/{documentId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.resource.size < 25 * 1024 * 1024
        && isAllowedFileType();
      allow delete: if isSignedIn();
    }

    // Everything else: no match → denied.
  }
}
