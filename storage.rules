rules_version = '2';

// ── Ophthalmology Platform — Cloud Storage Security Rules ────────────────────
//
// CURRENT MODE: Open access for sandbox / demo environment.
//
// Privacy posture (enforced at the application layer today):
//   • Firestore stores only the structured `storagePath`, never a public URL.
//   • Download URLs are resolved on demand via token-scoped getDownloadURL()
//     and are never persisted.
//   • Files live under deterministic paths:
//       documents/{linkedEntityType}/{linkedEntityId}/{documentId}/{safeFileName}
//
// TODO before production (DO NOT ship to real PHI without this):
//   1. Replace the wildcard rule with `allow read, write: if request.auth != null`
//      scoped to the user's org/clinic custom claims.
//   2. Validate contentType and size on write
//      (e.g. request.resource.size < 25 * 1024 * 1024).
//   3. Block public listing; require per-object token access only.
//
//   Example production rule (DO NOT enable yet):
//     match /documents/{type}/{entity}/{docId}/{file} {
//       allow read, write: if request.auth != null
//         && request.auth.token.orgId == resource.metadata.orgId;
//     }
//
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow all reads and writes for the demo / sandbox environment.
      // Lock this down before going to production with real patient data.
      allow read, write: if true;
    }
  }
}
