rules_version = '2';

// ── Ophthalmology Platform — Firestore Security Rules ─────────────────────────
//
// CURRENT MODE: Open access for sandbox / demo environment.
//
// TODO before production:
//   1. Replace the wildcard rule with per-collection rules scoped to
//      request.auth.uid and the user's org/clinic IDs (stored in custom claims).
//   2. Validate data shape with `request.resource.data` field checks.
//   3. Restrict write access to service accounts for seed operations.
//
// Example production rule structure (DO NOT enable yet):
//
//   match /patients/{id} {
//     allow read, write: if request.auth != null
//       && request.auth.token.orgId == resource.data.orgId;
//   }
//
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Allow all reads and writes for the demo / sandbox environment.
      // Lock this down before going to production with real patient data.
      allow read, write: if true;
    }
  }
}
