rules_version = '2';

// ── Ophthalmology Platform — Firestore Security Rules (Sprint 15) ────────────
//
// CURRENT MODE: Authenticated default-deny + custom-claim clinic isolation
//               + append-only audit trails.
//
//   • Every request must carry a Firebase Auth session.
//   • CLINIC CLAIMS (Sprint 15): staff accounts carry custom claims
//     { clinicId, role } minted exclusively by the trusted owner-credentialed
//     tool in backend/claims-admin.js. Clients can never set or alter claims.
//     A claims-bearing session can only read/write records belonging to its
//     own clinic — even a tampered request body with another clinicId is
//     denied. A 'network' claim grants cross-clinic access (executive scope).
//   • SANDBOX SESSIONS: anonymous sign-ins carry no clinic claim and retain
//     network-wide demo access. Documented; the sandbox holds no real PHI.
//   • Audit collections (activityFeed, appointmentAudit, documentAudit,
//     clinicalAudit) are APPEND-ONLY: update/delete always denied.
//   • staffDirectory is read-only for clients — written only by the trusted
//     admin tool (owner OAuth bypasses client rules by design).
//   • Unknown collections: no matching rule → denied.
//
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /** Clinic claim on the session token, or null for sandbox/anonymous. */
    function claimClinic() {
      return ('clinicId' in request.auth.token) ? request.auth.token.clinicId : null;
    }

    /** May this session touch a record with the given data?
        NOTE: deliberately uses the canonical `data.clinicId == claim` form and
        no membership (`in`) test — query analysis cannot prove membership
        tests, which silently ALLOWED unfiltered cross-clinic list queries for
        claim sessions (caught by test-rules-clinic-claims.js). Claim sessions
        therefore cannot read records lacking a clinicId — conservative deny. */
    function clinicAllowed(data) {
      return claimClinic() == null                 // sandbox (no claim, demo data)
        || claimClinic() == 'network'              // executive scope
        || data.clinicId == claimClinic();         // record belongs to the claimed clinic
    }

    // Writes that carry a clinicId must reference a real clinic.
    function validClinic() {
      return !('clinicId' in request.resource.data)
        || request.resource.data.clinicId in
           ['winter-park', 'clermont', 'lake-nona', 'tampa-asc', 'network'];
    }

    // Application data collections.
    function isAppCollection(name) {
      return name in [
        'patients', 'patientFlow', 'clinicalRecords', 'encounters', 'flowMoves',
        'appointments', 'waitlist', 'providers', 'locations',
        'claims', 'claimWork', 'insurancePayers', 'guarantors', 'glAccounts',
        'referrals', 'documents',
        'imagingStudies', 'imagingWork', 'surgeryCases', 'surgicalReadiness',
        'injectionSafety', 'opticalOrders', 'inventory',
        'canonicalIdentityMappings', 'identityMatchDecisions'
      ];
    }

    // Append-only audit trails — history can never be edited or deleted.
    function isAuditCollection(name) {
      return name in ['activityFeed', 'appointmentAudit', 'documentAudit', 'clinicalAudit'];
    }

    // Staff clinic-claims registry (display mirror; claims are authoritative).
    match /staffDirectory/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // trusted admin tool only
    }

    // Notifications (Sprint 19): clinic-scoped read; clients may only flip
    // status/readAt/archivedAt — every other field is immutable. No client
    // delete (archive instead). Cross-clinic access denied via clinicAllowed().
    match /notifications/{notificationId} {
      function immutableFieldsUnchanged() {
        return request.resource.data.clinicId == resource.data.clinicId
          && request.resource.data.type == resource.data.type
          && request.resource.data.severity == resource.data.severity
          && request.resource.data.title == resource.data.title
          && request.resource.data.message == resource.data.message
          && request.resource.data.recipientUserId == resource.data.recipientUserId
          && request.resource.data.createdAt == resource.data.createdAt
          && (!('sourceCollection' in resource.data) || request.resource.data.sourceCollection == resource.data.sourceCollection)
          && (!('sourceId' in resource.data) || request.resource.data.sourceId == resource.data.sourceId);
      }
      allow read:   if isSignedIn() && clinicAllowed(resource.data);
      allow create: if isSignedIn() && validClinic() && clinicAllowed(request.resource.data);
      allow update: if isSignedIn()
        && clinicAllowed(resource.data) && clinicAllowed(request.resource.data)
        && request.resource.data.status in ['unread', 'read', 'archived']
        && immutableFieldsUnchanged();
      allow delete: if false; // archive, never client-delete
    }

    match /{collection}/{docId} {
      allow read: if isSignedIn()
        && (isAuditCollection(collection)
            || (isAppCollection(collection) && clinicAllowed(resource.data)));
      allow create: if isSignedIn() && validClinic()
        && (isAuditCollection(collection)
            || (isAppCollection(collection) && clinicAllowed(request.resource.data)));
      allow update: if isSignedIn() && isAppCollection(collection) && validClinic()
        && clinicAllowed(resource.data) && clinicAllowed(request.resource.data);
      allow delete: if isSignedIn() && isAppCollection(collection) && clinicAllowed(resource.data);
    }
  }
}
