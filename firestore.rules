rules_version = '2';

// ── Ophthalmology Platform — Firestore Security Rules (Sprint 13) ────────────
//
// CURRENT MODE: Authenticated access, default-deny, append-only audit trails.
//
//   • Every request must carry a Firebase Auth session (the app signs in
//     anonymously at startup; unauthenticated REST/SDK access is denied).
//   • Only the explicit application collections below are accessible —
//     unknown collections are denied by the absence of any matching rule.
//   • Audit collections (activityFeed, appointmentAudit, documentAudit,
//     clinicalAudit) are APPEND-ONLY: create + read allowed, update/delete
//     always denied — audit history cannot be tampered with from a client.
//   • Writes carrying a clinicId must use a known clinic, preventing
//     fabricated cross-tenant records.
//
// KNOWN LIMIT (requires a backend before a real-PHI pilot):
//   Per-USER clinic isolation needs Firebase custom claims minted by a
//   trusted server (e.g. request.auth.token.clinicId == resource.data.clinicId).
//   Anonymous sessions cannot carry per-user claims, so all authenticated
//   sandbox users currently share read access. Tracked on /admin/pilot-readiness.
//
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Writes that carry a clinicId must reference a real clinic.
    function validClinic() {
      return !('clinicId' in request.resource.data)
        || request.resource.data.clinicId in
           ['winter-park', 'clermont', 'lake-nona', 'tampa-asc', 'network'];
    }

    // Application data collections (read/write for authenticated sessions).
    function isAppCollection(name) {
      return name in [
        'patients', 'patientFlow', 'clinicalRecords', 'encounters', 'flowMoves',
        'appointments', 'waitlist', 'providers', 'locations',
        'claims', 'claimWork', 'insurancePayers', 'guarantors', 'glAccounts',
        'referrals', 'documents',
        'imagingStudies', 'imagingWork', 'surgeryCases', 'surgicalReadiness',
        'injectionSafety', 'opticalOrders', 'inventory',
        'canonicalIdentityMappings', 'identityMatchDecisions'
      ];
    }

    // Append-only audit trails — history can never be edited or deleted.
    function isAuditCollection(name) {
      return name in ['activityFeed', 'appointmentAudit', 'documentAudit', 'clinicalAudit'];
    }

    match /{collection}/{docId} {
      allow read:   if isSignedIn() && (isAppCollection(collection) || isAuditCollection(collection));
      allow create: if isSignedIn() && (isAppCollection(collection) || isAuditCollection(collection)) && validClinic();
      allow update: if isSignedIn() && isAppCollection(collection) && validClinic();
      allow delete: if isSignedIn() && isAppCollection(collection);
    }
  }
}
