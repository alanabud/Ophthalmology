APP_PROJECT_NAME=Ophthalmology Enterprise Platform
APP_ENVIRONMENT=local
APP_API_V1_PREFIX=/api/v1
APP_SECRET_KEY=replace-with-a-generated-32-byte-secret
APP_DATABASE_URL=postgresql+asyncpg://ophthalmology:change-me@localhost:5432/ophthalmology
APP_REDIS_URL=redis://localhost:6379/0
APP_JWT_ISSUER=ophthalmology-enterprise-platform
APP_JWT_AUDIENCE=ophthalmology-enterprise-platform-users
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_MINUTES=10080
APP_DATABASE_POOL_SIZE=10
APP_DATABASE_MAX_OVERFLOW=20
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
APP_CORS_ALLOW_CREDENTIALS=true
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_WORKER_BROKER_URL=redis://localhost:6379/1
APP_WORKER_RESULT_BACKEND=redis://localhost:6379/2
